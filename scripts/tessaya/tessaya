#!/usr/bin/env bash
# tessaya — start (or rejoin) work inside Tessaya + Herdr, so a session is owned from birth (D68).
#
#   tessaya <project|dir> [claude|codex|<command…>]   new agent in a new tab of that project's space
#   tessaya --resume <claude-session-id> [dir]          bring an existing Claude conversation into Herdr
#   tessaya                                             attach to the space for the current directory
#
# Every agent started this way lives in a Herdr session named fab-<project>: it survives the
# terminal, T3 and ssh going away, appears in the Tessaya fleet on every device, and takes input
# from the fleet's send field. Nothing here touches an account; rotation happens underneath.
set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/tessaya-env.sh" 2> /dev/null || true

roots=(${BATON_ROOTS:-${FAB_ROOTS:-"$PWD" "$HOME" /home/onnyx /mnt/HC_Volume_106652742/dev "$HOME/dev"}})

resolve_dir() {
  local want="$1"
  if [[ -d "$want" ]]; then (cd "$want" && pwd); return; fi
  for root in "${roots[@]}"; do
    [[ -d "$root/$want" ]] && { (cd "$root/$want" && pwd); return; }
  done
  echo "tessaya: no directory named '$want' under ${roots[*]}" >&2
  exit 2
}

agent=()
if [[ "${1:-}" == "--resume" ]]; then
  [[ -n "${2:-}" ]] || { echo "usage: tessaya --resume <session-id> [dir]" >&2; exit 2; }
  dir="$(resolve_dir "${3:-$PWD}")"
  agent=(claude --resume "$2")
elif [[ $# -eq 0 ]]; then
  dir="$PWD"
else
  dir="$(resolve_dir "$1")"
  shift
  case "${1:-claude}" in
    claude) agent=(claude) ;;
    codex) agent=(codex) ;;
    *) agent=("$@") ;;
  esac
fi

# Legacy name: the `fab-` session prefix is kept so `baton` rejoins spaces `fab` started (D71).
name="fab-$(basename "$dir" | tr -c 'A-Za-z0-9_\n-' '-')"
running() { herdr session list 2>/dev/null | awk -v n="$name" '$1 == n && $2 == "running" { found = 1 } END { exit !found }'; }

# A live Claude process already holds this conversation (any account's sessions folder).
holder() {
  local f
  for f in "$HOME"/.claude/sessions/*.json "$HOME"/.claude-*/sessions/*.json \
    "$HOME"/.local/share/claude-swap/sessions/*/sessions/*.json; do
    [[ -f "$f" ]] && grep -q "\"sessionId\":\"$1\"" "$f" && kill -0 "$(basename "$f" .json)" 2> /dev/null && return 0
  done
  return 1
}
herdr_dir="$HOME/.config/herdr/sessions/$name"

# A resume never makes a twin: not while the conversation runs, not twice at once, and not when
# starting the space's server restores a pane that already resumes it.
restored=0
if ((${#agent[@]} > 0)) && [[ "${agent[1]:-}" == "--resume" ]]; then
  exec 9> "${XDG_RUNTIME_DIR:-/tmp}/tessaya-resume-${agent[2]}.lock"
  flock -w 60 9 || { echo "tessaya: another resume of ${agent[2]} is still starting" >&2; exit 1; }
  if holder "${agent[2]}"; then
    echo "tessaya: ${agent[2]} is already running; not starting a second copy"
    agent=()
  elif ! running && grep -q "\"value\": *\"${agent[2]}\"" "$herdr_dir/session.json" 2> /dev/null; then
    restored=1
  fi
fi

# The session's server runs headless and outlives this shell, so a plain attach (VS Code's
# terminal) never hosts it: closing the terminal leaves every agent in the space running.
if ! running; then
  (cd "$dir" && setsid herdr --session "$name" server </dev/null >/dev/null 2>&1 &)
  for _ in $(seq 1 50); do running && break; sleep 0.2; done
fi

if ((restored)); then
  # Herdr's restore brings the pane back; hold the lock until it is running so a second caller sees it.
  for _ in $(seq 1 60); do holder "${agent[2]}" && break; sleep 0.5; done
  echo "tessaya: ${agent[2]} restored by $name"
elif ((${#agent[@]} > 0)); then
  cmd="$(printf '%q ' "${agent[@]}")"
  if herdr --session "$name" workspace list 2>/dev/null | grep -q '"workspace_id"'; then
    herdr --session "$name" tab create --cwd "$dir" --label "${agent[0]}" --focus >/dev/null
  else
    herdr --session "$name" workspace create --cwd "$dir" --label "$(basename "$dir")" --focus >/dev/null
  fi
  # The newest pane is the one just created.
  pane="$(herdr --session "$name" pane list | grep -o '"pane_id":"[^"]*"' | tail -1 | cut -d'"' -f4)"
  herdr --session "$name" pane run "$pane" "$cmd" >/dev/null
  echo "tessaya: ${agent[0]} running in $name pane $pane"
  [[ "${agent[1]:-}" == "--resume" ]] && for _ in $(seq 1 60); do holder "${agent[2]}" && break; sleep 0.5; done
fi

if [[ -t 1 ]]; then
  cd "$dir"
  exec herdr --session "$name"
fi
echo "tessaya: $name ready in $dir (attach with: herdr --session $name)"
