#!/usr/bin/env bash
# baton — start (or rejoin) work inside Baton + Herdr, so a session is owned from birth (D68).
#
#   baton <project|dir> [claude|codex|<command…>]   new agent in a new tab of that project's space
#   baton --resume <claude-session-id> [dir]          bring an existing Claude conversation into Herdr
#   baton                                             attach to the space for the current directory
#
# Every agent started this way lives in a Herdr session named fab-<project>: it survives the
# terminal, T3 and ssh going away, appears in the Baton fleet on every device, and takes input
# from the fleet's send field. Nothing here touches an account; rotation happens underneath.
set -euo pipefail

roots=(${BATON_ROOTS:-${FAB_ROOTS:-"$PWD" "$HOME" /home/onnyx /mnt/HC_Volume_106652742/dev "$HOME/dev"}})

resolve_dir() {
  local want="$1"
  if [[ -d "$want" ]]; then (cd "$want" && pwd); return; fi
  for root in "${roots[@]}"; do
    [[ -d "$root/$want" ]] && { (cd "$root/$want" && pwd); return; }
  done
  echo "baton: no directory named '$want' under ${roots[*]}" >&2
  exit 2
}

agent=()
if [[ "${1:-}" == "--resume" ]]; then
  [[ -n "${2:-}" ]] || { echo "usage: baton --resume <session-id> [dir]" >&2; exit 2; }
  dir="$(resolve_dir "${3:-$PWD}")"
  agent=(claude --resume "$2")
elif [[ $# -eq 0 ]]; then
  dir="$PWD"
else
  dir="$(resolve_dir "$1")"
  shift
  case "${1:-claude}" in
    claude) agent=(claude) ;;
    codex) agent=(codex) ;;
    *) agent=("$@") ;;
  esac
fi

# Legacy name: the `fab-` session prefix is kept so `baton` rejoins spaces `fab` started (D71).
name="fab-$(basename "$dir" | tr -c 'A-Za-z0-9_\n-' '-')"
running() { herdr session list 2>/dev/null | awk -v n="$name" '$1 == n && $2 == "running" { found = 1 } END { exit !found }'; }

if ((${#agent[@]} > 0)); then
  cmd="$(printf '%q ' "${agent[@]}")"
  if ! running; then
    # The session's server runs headless and outlives this shell.
    (cd "$dir" && setsid herdr --session "$name" server </dev/null >/dev/null 2>&1 &)
    for _ in $(seq 1 50); do running && break; sleep 0.2; done
  fi
  if herdr --session "$name" workspace list 2>/dev/null | grep -q '"workspace_id"'; then
    herdr --session "$name" tab create --cwd "$dir" --label "${agent[0]}" --focus >/dev/null
  else
    herdr --session "$name" workspace create --cwd "$dir" --label "$(basename "$dir")" --focus >/dev/null
  fi
  # The newest pane is the one just created.
  pane="$(herdr --session "$name" pane list | grep -o '"pane_id":"[^"]*"' | tail -1 | cut -d'"' -f4)"
  herdr --session "$name" pane run "$pane" "$cmd" >/dev/null
  echo "baton: ${agent[0]} running in $name pane $pane"
fi

if [[ -t 1 ]]; then
  cd "$dir"
  exec herdr --session "$name"
fi
echo "baton: $name ready in $dir (attach with: herdr --session $name)"
