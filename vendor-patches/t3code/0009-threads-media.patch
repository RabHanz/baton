+export function collapsedWorkRunsAfterToggle(
+  collapsed: ReadonlySet<RunId>,
+  runId: RunId,
+  keep: boolean,
+): ReadonlySet<RunId> {
+  if (!keep) return collapsed;
+  const next = new Set(collapsed);
+  if (!next.delete(runId)) next.add(runId);
+  return next;
+}
