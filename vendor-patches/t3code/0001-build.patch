+export const BATON_VOICE_PAYLOAD_FILES = [
+  "baton-dictation.exe",
+  "models/melspectrogram.onnx",
+  "models/embedding_model.onnx",
+  "models/silero_vad.onnx",
+  "models/sebastian.onnx",
