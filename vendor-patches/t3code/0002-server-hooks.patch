+export const delegatesAsToken = (
+  session: Pick<AuthenticatedSession, "method" | "subject">,
+  isDesktopApp: boolean,
+): boolean =>
+  !isDesktopApp &&
+  !(session.method === "browser-session-cookie" && OWN_PAIRING_SUBJECTS.has(session.subject));
