      "name": "hold",
      "doubleTap": true,
      "events": [
        {
          "type": "down",
          "at": 0
        },
        {
          "type": "up",
          "at": 1000
        }
      ],
      "outputs": ["start", "stop"],
      "phase": "idle"
    },
    {
      "name": "medium press",
      "doubleTap": true,
      "events": [
